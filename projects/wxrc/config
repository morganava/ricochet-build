# vim: filetype=yaml sw=2
filename: '[% project %]-[% c("version") %]-[% c("var/build_id") %].tar.gz'
version: '[% c("var/versions/wxWidgets") %]'
container:
  use_container: 0

input_files:
  - name: wxrc-build
    project: wxrc-build
    target_replace:
      '^linux-.*': linux-x86_64
      '^windows-.*': linux-x86_64
      '^macos-.*': linux-x86_64
      '^windows$': linux
      '^macos$': linux